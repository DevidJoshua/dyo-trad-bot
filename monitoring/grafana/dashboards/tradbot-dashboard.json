{
  "dashboard": {
    "title": "TradBot Dashboard",
    "panels": [
      {
        "title": "Open Positions",
        "type": "stat",
        "targets": [{ "expr": "tradbot_open_positions", "legendFormat": "Open Positions" }]
      },
      {
        "title": "Daily Profit",
        "type": "stat",
        "targets": [{ "expr": "tradbot_daily_profit", "legendFormat": "Daily PnL" }]
      },
      {
        "title": "Monthly Profit",
        "type": "stat",
        "targets": [{ "expr": "tradbot_monthly_profit", "legendFormat": "Monthly PnL" }]
      },
      {
        "title": "Win Rate",
        "type": "gauge",
        "targets": [{ "expr": "tradbot_win_rate", "legendFormat": "Win Rate" }]
      },
      {
        "title": "MT5 Connection",
        "type": "stat",
        "targets": [{ "expr": "tradbot_mt5_connected", "legendFormat": "MT5 Status" }]
      },
      {
        "title": "Drawdown",
        "type": "graph",
        "targets": [{ "expr": "tradbot_drawdown", "legendFormat": "Drawdown" }]
      },
      {
        "title": "Orders Executed",
        "type": "stat",
        "targets": [{ "expr": "rate(tradbot_orders_executed_total[1h])", "legendFormat": "Orders/hr" }]
      },
      {
        "title": "Trade Latency",
        "type": "heatmap",
        "targets": [{ "expr": "tradbot_trade_latency_ms_bucket", "legendFormat": "Latency" }]
      }
    ]
  }
}
